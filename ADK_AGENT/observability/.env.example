# 관측(트레이싱) 환경변수 — 복사해서 .env 로 쓰고, 쓰는 백엔드만 채운다.
#   cp observability/.env.example observability/.env
# core/config.py 가 import 시 자동 로드한다 → source 불필요. 그냥 main.py 실행.
#   .venv/bin/python main.py --toc ...               # 기본 자동 전송(플래그 불필요)
#
# 채워진 백엔드만 활성화된다. 둘 다 채우면 같은 trace 가 양쪽으로 동시에(fan-out) 간다.
# 아무것도 안 채우면 조용히 OFF(평소처럼 생성만). 끄려면 main.py --no-trace.

# ── Phoenix (인증 없음) ──────────────────────────────────────────────
# 비우면 Phoenix 비활성. docker compose 로 띄웠으면 아래 그대로 두면 됨.
PHOENIX_OTLP_ENDPOINT=http://localhost:4317

# ── Langfuse (Basic 인증) ───────────────────────────────────────────
# Langfuse UI(http://localhost:3000) 에서 회원가입 → 프로젝트 생성 → Settings 의
# API Keys 에서 Public/Secret 키 발급 후 아래 3개를 채운다. 비우면 Langfuse 비활성.
LANGFUSE_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
