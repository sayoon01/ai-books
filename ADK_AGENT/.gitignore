# 가상환경 (대용량 — 커밋 금지)
.venv/

# 파이썬 캐시
__pycache__/
*.pyc

# 생성 산출물 (기본 로컬 전용). 아래 책은 산출물 커밋 허용( logs/ 제외).
output/*
!output/금형-사출-센서-데이터-자동-해석-가이드/
output/금형-사출-센서-데이터-자동-해석-가이드/*
!output/금형-사출-센서-데이터-자동-해석-가이드/**
output/금형-사출-센서-데이터-자동-해석-가이드/logs/**

# 스모크/스파이크 테스트 산출물
spikes/smoke_out/
spikes/*.log
spikes/*.out

# 관측 스택 (로컬 전용 — GitHub 미추적)
observability/

# 실행 로그
output_run.log
