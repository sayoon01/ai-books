# 가상환경 (대용량 — 커밋 금지)
.venv/

# 파이썬 캐시
__pycache__/
*.pyc

# 생성 산출물 (로컬 전용 — GitHub 미추적). 게시본은 ADK_AGENT/<책>/ 로 publish 단계가 따로 커밋함.
output/

# 스모크/스파이크 테스트 산출물
spikes/smoke_out/
spikes/*.log
spikes/*.out

# 관측 스택 (로컬 전용 — GitHub 미추적)
observability/

# 실행 로그
output_run*.log

# 비밀/접속정보 (MinIO 등 — 커밋 금지)
.env
.env.*
*.secrets.json
data/raw/
